            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">A report by Open Markets Institute on how AI agents could concentrate market and political power in a few companies, the risks to democracy and markets, and policy recommendations.</rdf:li>
            </rdf:Alt>
         </dc:description>
