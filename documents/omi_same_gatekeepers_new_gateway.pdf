         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Same Gatekeepers, New Gateway: AI Agents, Monopoly Power, and Democratic Risk</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Max von Thun</rdf:li>
